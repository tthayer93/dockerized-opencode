# Host directory containing your project source code (mounted at /workspace in the container).
HOST_WORKSPACE=/mnt/workspace

# Match the container user to your host UID/GID.
# Run `id -u` and `id -g` in your terminal, then replace 1000 below with your values.
PUID=1000
PGID=1000

# Web UI authentication (leave empty for no auth). Username is fixed to "opencode" in V2.
OPENCODE_PASSWORD="password"
